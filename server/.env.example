# Copy to server/.env. Never commit server/.env.
PORT=4000

# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepdive

# Boson AI (Higgs TTS and STT)
BOSON_API_KEY=

# S3 bucket for recordings (optional). Check: npm run s3:check -w server
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# DeepSeek (questions and scoring)
DEEPSEEK_API_KEY=

# Anthropic (optional backup LLM). Check: npm run llm:check -w server
ANTHROPIC_API_KEY=
