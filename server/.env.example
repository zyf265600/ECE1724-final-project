# Copy this file to server/.env and fill in real values. Never commit server/.env.
PORT=4000

# Local PostgreSQL database, e.g. postgresql://USER:PASSWORD@localhost:5432/deepdive
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepdive

# Boson AI key (starts with bai-), used for Higgs TTS and STT
BOSON_API_KEY=

# Private S3 bucket for answer recordings (IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject on it).
# Check it with: npm run s3:check -w server. Without S3_BUCKET, answers are saved without their recording
# and the report has no "Play my answer".
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# DeepSeek key, used to write the interviewer's follow-up questions and to score the interview
DEEPSEEK_API_KEY=

# Optional Anthropic key: when DeepSeek is unavailable, Claude answers with the same prompts.
# Check both with: npm run llm:check -w server
ANTHROPIC_API_KEY=
